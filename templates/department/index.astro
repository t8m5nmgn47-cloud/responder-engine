---
import Base from '../../layouts/Base.astro';
import DistrictMap from '../../components/DistrictMap.astro';
import d from '@content/dept.json';
import { copy } from '../../components/copy.js';
import { pick, p800 } from '../../components/photos.js';
const cp = copy(d);
import inc from '@content/incidents.json';
import ev from '@content/events.json';
import FacebookFeed from '../../components/FacebookFeed.astro';
import ProgramCards from '../../components/ProgramCards.astro';
import siteConfig from '@siteconfig';
const patch: string = (siteConfig as any).patch === false ? '' : ((siteConfig as any).patch || '/patch.svg'); // 0.10.2: patch:false omits it
const tel = (n: string) => `tel:+1${n.replace(/\D/g, '')}`;
const latest = d.news.slice(0, 3);
const runs = inc.incidents.slice(0, 3);
const today = new Date().toISOString().slice(0, 10);
const future = (ev.events as any[]).filter((e) => (e.end || e.date) >= today).sort((a, b) => a.date.localeCompare(b.date));
const meeting = future.find((e) => e.type === 'meeting');
const upcoming = future.filter((e) => e !== meeting).slice(0, 3);
const tasks: { label: string; href: string; icon?: string }[] = ((d as any).tasks || []).slice(0, 6);
const programs: any[] = (d as any).programs || [];
const rigPhotos = (d.apparatus || []).slice(0, 4).some((r: any) => r.photo); // 0.10.2
// "Right now" cards (0.3.4): hiring notices, upcoming events, anything current. Hidden when absent.
const notices: { kind?: string; title: string; text: string; date?: string; href: string; cta?: string }[] = (d as any).notices || [];
const noticeTag: Record<string, string> = { hiring: 'Now hiring', event: 'Event', notice: 'Notice' };
// Optional feature-block photo (0.3.4): `feature.photo {src, alt, aspect?}` instead of photos.chief_engine.
const featPhoto = (cp.feature && (cp.feature as any).photo) || pick(d, 'chief_engine');
const doorA = pick(d, 'structure'), doorB = pick(d, 'community'), doorC = pick(d, 'glow');
const heroPhoto = d.hero_photo && d.hero_photo.src ? d.hero_photo : null;
const featAspect = (cp.feature && (cp.feature as any).photo && (cp.feature as any).photo.aspect) || '';
const fmtLong = (s: string) => new Date(s + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
const fmt = (s: string) => new Date(s + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
const s = d.seasonal;
const inSeason = s && s.start <= today && today <= s.end;
// 0.7.0: `home.hide` lists home sections to leave out: groupband | feature | seasonal | pager | district | rigs | programs | doors | news | facebook | support
const hide = new Set<string>(((d as any).home && (d as any).home.hide) || []);
// 0.7.0: seasonal.photo {src, alt, position?} turns the seasonal band into text + photo; seasonal.link/link_label become its first button
const sPhoto = s && (s as any).photo;
// 0.7.0: district.map_embed {query, zoom?, note?} embeds a map of the station address when there is no drawn DistrictMap
const mapEmbed = (d as any).district && (d as any).district.map_embed;
const mapSrc = mapEmbed ? `https://www.google.com/maps?q=${encodeURIComponent(mapEmbed.query)}&z=${mapEmbed.zoom || 11}&output=embed` : '';
const mapDir = mapEmbed ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapEmbed.query)}` : '';
const compact = !!(d as any).hero_compact;
// 0.9.0: iso_page.home (true) adds a 'what the rating saves you' band before the support band
const ipg: any = (d as any).iso_page || {};
const ipCls = String(ipg.rating || ((d as any).iso_rating || {}).class || '');
const ipF: Record<string, number[]> = ipg.factors || { '3': [.98, .88], '9E': [1.4, 1.25], '9': [1.4, 1.25], '10': [1.75, 1.55] };
const ipBase = Number(ipg.base_premium || 2400);
const ipWorst = ipg.split || '9';
const ipSave = ipg.home && ipF[ipCls] && ipF[ipWorst] ? Math.round((ipBase * ipF[ipWorst][0] / ipF[ipCls][0] - ipBase) / 50) * 50 : 0;
// 0.8.0: `store.home` (true) shows the featured edition and up to three items on the home page
const st: any = (d as any).store || {};
// 0.10.4: `founded` is optional (0 or missing hides "Since" and the years tile); the stat band needs two tiles to show
const statTiles = [d.stats.members > 0, d.stats.calls_2024 > 0, d.district.area_sq_mi > 0, !(d.stats.calls_2024 > 0), d.founded > 0].filter(Boolean).length;
const shopHome: any[] = st.home ? [...(st.featured ? [{ ...st.featured, name: st.featured.title, photo: (st.featured.photos && st.featured.photos[0] && st.featured.photos[0].src) || st.featured.photo, alt: st.featured.photos && st.featured.photos[0] && st.featured.photos[0].alt }] : []), ...(st.items || [])].slice(0, 3) : [];
---
<Base title="Home" description={cp.home_meta}>
  <section class="hero-x" aria-label="Welcome" style={[d.hero_bg ? `--hero-bg:url(${d.hero_bg.src});--hero-bg-800:url(${d.hero_bg.src.replace(/\.jpg$/, "-800.jpg")});--hero-pos:${d.hero_bg.position || "center 40%"}` : "--hero-bg:none;--hero-bg-800:none", d.hero_patch_scale ? `--hpatch-scale:${d.hero_patch_scale}` : ""].filter(Boolean).join(";") || undefined}>
    <div class="wrap">
      <div class={`hx${compact ? " compact" : ""}`}>
        {patch && <img class="hpatch" src={patch} alt={`${d.name} patch`} width="140" height="161" loading="eager" />}
        <p class="kicker">{[d.tagline, cp.county, d.founded ? `Since ${d.founded}` : ""].filter(Boolean).join(" · ")}</p>
        <h1>{cp.hero_h1}</h1>
        <p class="lede">{cp.hero_lede}</p>
        <div class="acts">
          <a class="btn red" href={cp.hero_cta1_href}>{cp.hero_cta1}</a>
          <a class="btn light" href={cp.hero_cta2_href}>{cp.hero_cta2}</a>
        </div>
      </div>
    </div>
  </section>

  {tasks.length > 0 && <nav class="tasksband cut" aria-label="I want to">
    <div class="wrap">
      <h2 class="sr">I want to</h2>
      <ul class="tasks">{tasks.map((t) => <li><a class="task" href={t.href}>{t.icon && <span class="ti" aria-hidden="true">{t.icon}</span>}<span class="tl">{t.label}</span></a></li>)}</ul>
    </div>
  </nav>}

  {notices.length > 0 && <section class="section tight nowband" aria-label="Right now">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">Right now</p><h2 class="sr">Current notices</h2></div>
      <div class="nows" data-reveal-group>
        {notices.map((n) => <a class="now" href={n.href}><span class="tag">{noticeTag[n.kind || 'notice'] || n.kind}</span>{n.date && <time class="nd" datetime={n.date}>{fmtLong(n.date)}</time>}<h3>{n.title}</h3><p>{n.text}</p><span class="go">{n.cta || 'Details'}</span></a>)}
      </div>
    </div>
  </section>}

  {statTiles >= 2 && <section class="statband" aria-label="The department by the numbers">
    <div class="wrap">
      <div class="stats" data-reveal-group>
        {d.stats.members > 0 && <div class="stat"><div class="v" data-count>{d.stats.members}</div><div class="k">{cp.members_label}</div></div>}
        {d.stats.calls_2024 > 0 && <div class="stat"><div class="v" data-count>{d.stats.calls_2024}</div><div class="k">Calls in 2024</div></div>}
        {d.district.area_sq_mi > 0 && <div class="stat"><div class="v" data-count>{d.district.area_sq_mi}</div><div class="k">Square miles protected</div></div>}
        {!(d.stats.calls_2024 > 0) && <div class="stat"><div class="v">24/7</div><div class="k">{cp.stat_247}</div></div>}
        {d.founded > 0 && <div class="stat"><div class="v" data-count data-since={d.founded}>{new Date().getFullYear() - d.founded}</div><div class="k">Years of service</div></div>}
      </div>
    </div>
  </section>}

  {!hide.has("groupband") && heroPhoto && <figure class="groupband"><img src={heroPhoto.src} alt={heroPhoto.alt} width="1100" height="400" loading="eager" /><figcaption><div class="wrap">{heroPhoto.caption}</div></figcaption></figure>}


  {cp.feature && !hide.has("feature") && <section class="section feat">
    <div class="wrap">
      <div class={`featgrid${featPhoto ? "" : " solo"}`} data-reveal-group>
        {featPhoto ? <img src={p800(featPhoto)} alt={featPhoto.alt} width="800" height="1067" loading="lazy" style={featAspect ? `aspect-ratio:${featAspect}` : undefined} />
          : <div><p class="kicker">{cp.feature.kicker}</p><h2>{cp.feature.title}</h2></div>}
        <div>
          {featPhoto && <p class="kicker">{cp.feature.kicker}</p>}
          {featPhoto && <h2>{cp.feature.title}</h2>}
          <p class="lede">{cp.feature.text}</p>
          <p style="margin-top:1.25rem"><a class="btn" href={cp.feature.href}>{cp.feature.link_label}</a></p>
        </div>
      </div>
    </div>
  </section>}
  {inSeason && !hide.has("seasonal") && (sPhoto
    ? <section class="section charband seasonband"><div class="wrap"><div class="seasongrid"><div><p class="kicker">{s.kicker}</p><h2>{s.title}</h2><p>{s.text}</p><div class="acts">{s.link && <a class="btn light" href={s.link} rel="noopener">{s.link_label || "Learn more"}</a>}<a class={`btn light${s.link ? " ghost" : ""}`} href="/safety/">Fire safety at home</a></div></div><div class="seasonpic"><img src={sPhoto.src.replace(".jpg","-800.jpg")} alt={sPhoto.alt || ""} width="800" height="1067" loading="lazy" style={sPhoto.position ? `object-position:${sPhoto.position}` : undefined} /></div></div></div></section>
    : <section class="section tight charband"><div class="wrap"><div class="seasonal"><div><p class="kicker">{s.kicker}</p><h2 style="margin-top:.4rem">{s.title}</h2><p style="margin-top:.6rem;max-width:60ch">{s.text}</p></div><div><a class="btn light" href="/safety/">Fire safety at home</a></div></div></div></section>)}

  {!hide.has("pager") && <section class="section">
    <div class="wrap">
      <div class="two">
        <div>
          <div class="head" data-reveal><p class="kicker">Recent responses</p><h2>What the pager said</h2></div>
          <ol class="mini">
            {runs.map((r) => <li>{r.n && !/^\d{2}-0{3,}$/.test(r.n) && <span class="mn">{r.n}</span>}<span class="md">{fmt(r.date)}</span><span class="mt"><b>{r.type}</b> · {r.location}</span></li>)}
          </ol>
          <p style="margin-top:1.25rem"><a class="btn" href="/responses/">All responses</a></p>
        </div>
        <div>
          <div class="head" data-reveal><p class="kicker">Coming up</p><h2>Events</h2></div>
          {meeting && <div class="meet"><p class="mk2">Next board meeting</p><p class="mt2">{fmtLong(meeting.date)}{meeting.time && `, ${meeting.time}`}</p><p class="mw">{meeting.where}{meeting.text && ` · ${meeting.text}`}</p><p class="ml">{meeting.agenda_url && <a href={meeting.agenda_url} rel="noopener">Agenda</a>}<a href="/news/">Full schedule</a></p></div>}
          {upcoming.length ? <ol class="mini">{upcoming.map((e) => <li><span class="md">{fmt(e.date)}</span><span class="mt"><b>{e.title}</b> · {e.where}{e.time && ` · ${e.time}`}</span></li>)}</ol> : <p class="small">Nothing scheduled right now.</p>}
          <p style="margin-top:1.25rem"><a class="btn" href="/news/">{cp.events_link}</a></p>
        </div>
      </div>
    </div>
  </section>}

  {!hide.has("district") && <section class="section band">
    <div class="wrap">
      <div class="mapgrid">
        <div>
          <div class="head" data-reveal><p class="kicker">The district</p><h2>{cp.district_title}</h2></div>
          <div class="prose">
            <p>{cp.territory_long}</p>
            <p class="small" style="margin-top:1rem">{cp.district_note}{cp.map && ' Boundaries from the U.S. Census Bureau.'}</p>
          </div>
        </div>
        {cp.map && <DistrictMap />}
        {!cp.map && mapEmbed && <div class="dmap-wrap"><iframe class="dmap" title={`Map showing ${cp.station_label}, ${mapEmbed.query}`} src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><p class="small mapnote">{mapEmbed.note || `${cp.station_label}, ${d.address.street}.`} <a href={mapDir} rel="noopener">Directions</a> · Not sure you&rsquo;re in the district? <a href={tel(d.phones.station)}>Call the station</a>.</p></div>}
      </div>
    </div>
  </section>}

  {!hide.has("rigs") && <section class="section charband cut up">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">On the floor</p><h2>{cp.rigs_title}</h2></div>
      <div class="rigs" data-reveal-group>
        {d.apparatus.slice(0, 4).map((r) => (
          <div class="rig">{r.photo ? <img class="rphoto" src={r.photo.replace(".jpg","-800.jpg")} alt={r.alt || `${r.kind} ${r.id}`} loading="lazy" width="800" height="600" /> : (rigPhotos ? <div class="photo" role="img" aria-label={`Reserved for a photograph of ${r.kind} ${r.id}`}></div> : null)}<div class="in"><div class="id">{r.id}</div><div class="kind">{r.kind}{r.year ? ` · ${r.year}` : ""}</div>{r.make && <div class="mk">{r.make}</div>}{r.spec && <div class="sp">{r.spec}</div>}</div></div>
        ))}
      </div>
      {cp.rigs_note && <p class="small rignote">{cp.rigs_note}</p>}
      <p style="margin-top:1.5rem"><a class="btn" href="/apparatus/">{cp.apparatus_link}</a></p>
    </div>
  </section>}

  {programs.length >= 3 && !hide.has("programs") && <section class="section">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">What we do</p><h2>Beyond the fire calls</h2></div>
      <ProgramCards limit={3} />
      {programs.length > 3 && <p style="margin-top:1.5rem"><a class="btn" href="/community/#programs">All our programs</a></p>}
    </div>
  </section>}

  {!hide.has("doors") && <section class="section band">
    <div class="wrap">
      <div class={`doors three pdoors${doorA || doorB || doorC ? "" : " nophoto"}`} data-reveal-group>
        <a class="door" href="/safety/#911"><span class="tag">Safety</span>{doorA && <img src={p800(doorA)} alt={doorA.alt} loading="lazy" width="800" height="600" />}<h3>What happens when you call 911</h3><p>{cp.call_door}</p><span class="go">How it works</span></a>
        <a class="door" href="/community/"><span class="tag">Community</span>{doorB && <img src={p800(doorB)} alt={doorB.alt} loading="lazy" width="800" height="1067" />}<h3>For residents</h3><p>{cp.community_door}</p><span class="go">Community</span></a>
        <a class="door" href="/memorial/"><span class="tag char">Memorial</span>{doorC && <img src={p800(doorC)} alt={doorC.alt} loading="lazy" width="800" height="1067" />}<h3>In memory</h3><p>{cp.memorial_door}</p><span class="go">Memorial</span></a>
      </div>
    </div>
  </section>}

  {!hide.has("news") && <section class="section tight">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">Latest</p><h2>News from the station</h2></div>
      <div class="ncards" data-reveal-group>{latest.map((n) => <a class={`ncard${n.photo ? '' : ' nophoto'}`} href="/news/"><span class={`tag${(n as any).tag === 'Awards' ? ' gold' : ''}`}>{(n as any).tag || 'Department'}</span>{n.photo && <img src={n.photo.replace(".jpg","-800.jpg")} alt={n.alt || ""} loading="lazy" />}<div class="in"><time datetime={n.date}>{fmt(n.date)}, {n.date.slice(0,4)}</time><h3>{n.title}</h3><p>{n.text}</p></div></a>)}</div>
    </div>
  </section>}

  {shopHome.length > 0 && <section class="section tight">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">{st.home_kicker || "Shop"}</p><h2>{st.home_title || "Wear the patch"}</h2></div>
      <div class="shophome" data-reveal-group>{shopHome.map((p) => <a class="shopcard" href="/shop/">{p.photo ? <img src={p.photo} alt={p.alt || p.name} loading="lazy" width="800" height="800" /> : <span class="reserved" role="img" aria-label={`Reserved for a photograph of ${p.name}`}></span>}<span class="in"><span class="h3">{p.name}</span>{p.price && <span class="pr">{p.price}</span>}</span></a>)}</div>
      <p style="margin-top:1.5rem"><a class="btn" href="/shop/">{st.home_link || "Open the shop"}</a></p>
    </div>
  </section>}

  {!hide.has("facebook") && <FacebookFeed />}

  {ipg.home && ipSave > 0 && <section class="section tight isoband" aria-label="Insurance rating">
    <div class="wrap">
      <div class="isogrid" data-reveal-group>
        <div class="isonum" aria-hidden="true"><span class="n">{ipCls}</span><span class="l">ISO class</span></div>
        <div>
          <p class="kicker">{ipg.home_kicker || "What our rating saves you"}</p>
          <h2>{ipg.home_title || `About $${ipSave.toLocaleString("en-US")} a year on a typical home's insurance.`}</h2>
          <p class="lede" style="margin-top:.6rem;max-width:52ch">{ipg.home_text || `Insurers price every policy in the district on the department's Class ${ipCls} rating. Without a rated department the same house is a ${ipWorst}. See what it means for yours.`}</p>
          <p style="margin-top:1.25rem"><a class="btn red" href="/rating/#calculator">{ipg.home_link || "Run the numbers for your house"}</a></p>
        </div>
      </div>
    </div>
  </section>}

  {!hide.has("support") && <section class="section redband cut up">
    <div class="wrap">
      <div class="seasonal">
        <div><p class="kicker">Support</p><h2 style="margin-top:.4rem">{cp.support_h2} <span>{cp.support_h2b}</span></h2><p style="margin-top:.6rem;max-width:56ch">{cp.support_blurb}</p></div>
        <div><a class="btn light" href="/support/">Support the department</a></div>
      </div>
    </div>
  </section>}

  <script>(function(){var y=new Date().getFullYear();document.querySelectorAll("[data-since]").forEach(function(e){e.textContent=String(y-Number(e.getAttribute("data-since")))})})();</script>

  <style is:global>
    .feat{background:var(--bg-2)}
    .featgrid{display:grid;gap:2rem;grid-template-columns:1fr;align-items:center}
    .featgrid h2+.lede{margin-top:1rem}
    .featgrid img{width:100%;max-width:26rem;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:2px;border:4px solid var(--card);box-shadow:0 10px 30px rgba(0,0,0,.18)}
    @media (min-width:60rem){.featgrid{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:3.5rem}}
    /* 0.10.2: no feature photo: title on the left, text on the right, so the band does not sit half empty */
    .featgrid.solo{align-items:start}
    .featgrid.solo .lede{max-width:52ch;margin-top:0}
    @media (min-width:60rem){.featgrid.solo{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:4rem}.featgrid.solo>div:last-child{padding-top:.5rem}}
    .two{display:grid;gap:2.5rem;grid-template-columns:1fr}
    @media (min-width:60rem){.two{grid-template-columns:1fr 1fr}}
    .mini{display:grid;gap:0;border-top:1px solid var(--rule)}
    .mini li{display:grid;grid-template-columns:auto 1fr;gap:.2rem 1rem;padding:.75rem 0;border-bottom:1px solid var(--rule-2)}
    .mini .mn{font:700 1rem/1.3 var(--display);color:var(--red);letter-spacing:.04em;grid-row:1}
    .mini .md{font-size:.85rem;color:var(--ink-lo);grid-column:1;font-variant-numeric:tabular-nums;white-space:nowrap}
    .mini .mt{grid-column:2;grid-row:1/3}
    .mini li:has(.mn) .md{grid-row:2}
    .mapgrid{display:grid;gap:2rem;grid-template-columns:1fr;align-items:center}
    @media (min-width:60rem){.mapgrid{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr)}}
    .seasonal{display:flex;flex-wrap:wrap;gap:1.5rem 3rem;align-items:center;justify-content:space-between}
    /* 0.10.3: a long headline no longer pushes the button onto its own row; the text block yields room for it */
    .seasonal>div:first-child{flex:1 1 30rem;min-width:0;max-width:46rem}
    .seasonal>div:last-child{flex:0 0 auto}
    .seasonal h2{font-size:clamp(1.6rem,1.3rem + 1.2vw,2.4rem)}
    .seasonal h2{font-size:clamp(2rem,1.5rem + 1.8vw,3rem)}
    .hero-x .hx.compact h1{font-size:clamp(3rem,1.8rem + 5vw,6.25rem);max-width:12ch}
    .hero-x .hx.compact .lede{max-width:46ch}
    .seasonband{padding-top:0;padding-bottom:0;overflow:hidden}
    .seasongrid{display:grid;grid-template-columns:1fr;gap:0;align-items:stretch}
    .seasongrid>div{padding:clamp(2.5rem,6vw,4.5rem) 0}
    .seasongrid h2{font-size:clamp(2rem,1.5rem + 1.8vw,3rem);margin-top:.4rem}
    .seasongrid p{margin-top:.6rem;max-width:56ch}
    .seasongrid .acts{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}
    .seasongrid .btn.ghost{border-color:rgba(255,255,255,.4)}
    .seasonpic{display:none}
    @media (min-width:60rem){.seasongrid{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:3rem}.seasonpic{display:block;position:relative;min-height:26rem;margin-right:calc(var(--gutter) * -1)}.seasonpic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%}}
    .dmap-wrap{display:grid;gap:.6rem}
    .dmap{width:100%;aspect-ratio:4/3;border:0;border-radius:2px;background:var(--bg-2);box-shadow:0 10px 30px rgba(0,0,0,.12)}
    .mapnote{color:var(--ink-lo)}
    .rignote{margin:1.25rem 0 0;max-width:60ch;color:rgba(243,239,230,.7)}
    .isoband{background:var(--bg-2)}
    .isogrid{display:grid;gap:1.5rem 3rem;grid-template-columns:1fr;align-items:center}
    @media (min-width:52rem){.isogrid{grid-template-columns:auto 1fr}}
    .isonum{display:flex;flex-direction:column;align-items:center;line-height:1}
    .isonum .n{font:700 clamp(6rem,5rem + 6vw,10rem)/.85 var(--display);color:var(--red)}
    .isonum .l{font:700 .8rem/1 var(--display);letter-spacing:.18em;text-transform:uppercase;color:var(--ink-lo);margin-top:.4rem}
    .shophome{display:grid;gap:1rem;grid-template-columns:1fr}
    @media (min-width:44rem){.shophome{grid-template-columns:repeat(3,1fr)}}
