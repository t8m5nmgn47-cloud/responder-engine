---
import Base from '../../layouts/Base.astro';
import d from '@content/dept.json';
import { copy } from '../../components/copy.js';
import { pick, p800 } from '../../components/photos.js';
const cp = copy(d);
const tel = (n: string) => `tel:+1${n.replace(/\D/g, '')}`;
const phone = (d.phones && d.phones.station) || '';
const jph = pick(d, 'members_dog', 'squad');
// Optional career / paid-position block (0.3.4): `careers {kicker?, title, text, cta?, href?}` renders a #career section.
const careers = (d as any).careers as { kicker?: string; title: string; text: string; cta?: string; href?: string } | undefined;
// 0.12.0: everything this page says about the department comes from dept.json `join`; a part that is missing is left
// out rather than filled with someone else's rules. `join` = { requirements?: [{title,text}],
// benefits?: {kicker?, title?, paragraphs: [], issued_title?, issued?: []}, steps?: [{title,text}], steps_note?,
// visit?: {kicker?, title, text, cta?, href?}, reply_note?, next?: [] }.
type Item = { title: string; text: string };
const j: any = (d as any).join || {};
const reqs: Item[] = j.requirements || [];
const ben: any = j.benefits && (j.benefits.paragraphs || []).length ? j.benefits : null;
const steps: Item[] = j.steps || [];
const stepsNote: string = j.steps_note ?? cp.join_steps_note;
const visit: any = j.visit && j.visit.title ? j.visit : null;
const next: string[] = j.next || [];
const email: string = (d as any).email || '';
const replyNote: string = j.reply_note || (email ? `Sending opens your email program with this filled in, addressed to the department at ${email}.` : '');
const parts = [reqs.length && 'what it takes', ben && 'what you get', steps.length && 'the steps', 'and how to reach us'].filter(Boolean) as string[];
const desc = `How to join the ${d.name} as a volunteer: ${parts.length > 1 ? parts.join(', ') : 'how to reach us'}.`;
---
<Base title="Join" description={desc}>
  <section class={jph ? "phero two" : "phero"} style={jph ? `--pbg:url(${jph.src})` : undefined}>
    <div class="wrap">
      <div>
        <p class="kicker">Join the department</p>
        <h1 style="margin-top:.75rem">You don't have to be a hero. You have to show up.</h1>
        <p class="lede">{cp.join_lede}</p>
        <div class="acts"><a class="btn red" href="#apply">Start here</a>{phone && <a class="btn" href={tel(phone)}>Call the station</a>}</div>
      </div>
      {jph && <figure class="hphoto"><img src={p800(jph)} alt={jph.alt} width="800" height="600" fetchpriority="high" />{cp.join_caption && <figcaption>{cp.join_caption}</figcaption>}</figure>}
    </div>
  </section>

  {reqs.length > 0 && <section class="section band">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">Plain terms</p><h2>What it takes</h2></div>
      <div class="facts three">
        {reqs.map((r) => <div class="fact"><h3>{r.title}</h3><p>{r.text}</p></div>)}
      </div>
    </div>
  </section>}

  {ben && <section class="section">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">{ben.kicker || 'What you get'}</p><h2>{ben.title || 'What the department gives you'}</h2></div>
      <div class="split"><div><div class="prose">
        {ben.paragraphs.map((p: string) => <p>{p}</p>)}
      </div></div>{(ben.issued || []).length > 0 && <aside class="aside"><div class="aside-card"><p class="kicker">{ben.issued_title || 'Issued to you'}</p><ul>{ben.issued.map((i: string) => <li>{i}</li>)}</ul></div></aside>}</div>
    </div>
  </section>}

  {steps.length > 0 && <section class="section">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">The road in</p><h2>From first call to first call</h2></div>
      <div class="split"><div>
      <ol class="steps2">
        {steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
      </ol>
      <p class="small" style="margin-top:1.5rem;max-width:62ch">{stepsNote ? stepsNote + ' ' : ''}The National Volunteer Fire Council's <a href="https://makemeafirefighter.org" rel="noopener">Make Me A Firefighter</a> site answers the general questions, and lists departments near you.</p>
      </div>{jph && <aside class="aside"><figure class="aside-photo"><img src={p800(jph)} alt={jph.alt} loading="lazy" width="800" height="1000" /><figcaption>{jph.alt}</figcaption></figure></aside>}</div>
    </div>
  </section>}

  {visit && <section class="section charband">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">{visit.kicker || 'Not sure yet?'}</p><h2>{visit.title}</h2></div>
      <div class="prose" style="max-width:60ch">
        <p>{visit.text}{phone && <> Call the station at <a href={tel(phone)}>{phone}</a>, or send the form below.</>}</p>
        {visit.href && <p style="margin-top:1.4rem"><a class="btn light" href={visit.href} rel="noopener">{visit.cta || 'Learn more'}</a></p>}
      </div>
    </div>
  </section>}

  {careers && <section class="section band" id="career">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">{careers.kicker || 'Career positions'}</p><h2>{careers.title}</h2></div>
      <div class="prose" style="max-width:62ch">
        <p>{careers.text}</p>
        <p style="margin-top:1.25rem"><a class="btn red" href={careers.href || tel(phone)}>{careers.cta || 'Call the station'}</a></p>
      </div>
    </div>
  </section>}

  <section class="section" id="apply">
    <div class="wrap">
      <div class="head"><p class="kicker">Apply</p><h2>Tell us who you are</h2>{replyNote && <p class="small" style="max-width:60ch">{replyNote}</p>}</div>
      <div class="split"><div>
      <form class="jf" id="jf" novalidate data-site={d.name} data-short={cp.short} data-to={email}>
        <div class="f"><label for="j-name">Your name *</label><input id="j-name" name="name" autocomplete="name" required></div>
        <div class="f"><label for="j-phone">Phone *</label><input id="j-phone" name="phone" type="tel" autocomplete="tel" required></div>
        <div class="f"><label for="j-email">Email</label><input id="j-email" name="email" type="email" autocomplete="email"></div>
        <div class="f"><label for="j-age">Age *</label><input id="j-age" name="age" type="number" min="14" max="99" required></div>
        <div class="f wide"><label for="j-addr">{cp.join_address_label} *</label><input id="j-addr" name="address" required placeholder={cp.address_placeholder || undefined}></div>
        <div class="f wide"><label for="j-why">Anything you want us to know</label><textarea id="j-why" name="about" rows="4" placeholder="Experience, availability, questions"></textarea></div>
        <div class="bar2"><button class="btn red" type="submit">Send</button><p class="small" id="j-status" aria-live="polite"></p></div>
        <details class="fb" id="j-fb" hidden><summary>If your email program didn't open, copy this and send it{phone ? ', or call the station' : ''}.</summary><textarea readonly rows="9"></textarea></details>
      </form>
      </div>{(next.length > 0 || phone) && <aside class="aside"><div class="aside-card">{next.length > 0 ? <><p class="kicker">What happens next</p><ul>{next.map((n) => <li>{n}</li>)}</ul></> : <p class="kicker">Questions first?</p>}{phone && <p>{next.length > 0 ? 'Questions first? ' : 'Call the station: '}<a href={tel(phone)}>{phone}</a>.</p>}</div></aside>}</div>
    </div>
  </section>

  <script>
    const f = document.getElementById('jf') as HTMLFormElement;
    const st = document.getElementById('j-status')!; const fb = document.getElementById('j-fb') as HTMLDetailsElement;
    const to = f.dataset.to || ''; // dept.json `email` (0.12.0); without one the visitor copies the text instead
    const SITE = f.dataset.site || 'the department'; const SHORT = f.dataset.short || SITE;
    f.addEventListener('submit', (e) => {
      e.preventDefault(); if (!f.reportValidity()) return;
      const lines: string[] = [];
      f.querySelectorAll<HTMLElement>('.f').forEach((w) => { const l = w.querySelector('label')!.textContent!.replace(/\s*\*$/, '').trim(); const el = w.querySelector('input,textarea') as HTMLInputElement; if (el.value.trim()) lines.push(`${l}: ${el.value.trim()}`); });
      const body = lines.join('\n') + '\n\nSent from the ' + SITE + ' website.';
      const ta = fb.querySelector('textarea') as HTMLTextAreaElement; ta.value = `To: ${to || '(the department)'}\nSubject: ${SHORT} volunteer inquiry\n\n${body}`;
      fb.hidden = false; fb.open = true;
      if (to) { st.textContent = 'Opening your email program…'; location.href = `mailto:${to}?subject=${encodeURIComponent(SHORT + ' volunteer inquiry')}&body=${encodeURIComponent(body)}`; }
      else st.textContent = 'This form has no email address yet. Copy the text below and send it, or call the station.';
    });
  </script>
  <style is:global>
    .steps2{counter-reset:s;display:grid;gap:0;border-top:1px solid var(--rule);max-width:56rem}
    .steps2 li{display:grid;grid-template-columns:3.5rem 1fr;gap:1rem;padding:1.3rem 0;border-bottom:1px solid var(--rule)}
    .steps2 li::before{counter-increment:s;content:counter(s);font:700 2.6rem/1 var(--display);color:var(--red)}
    .steps2 h3{font-size:1.35rem;margin-bottom:.3rem}
    .steps2 p{max-width:60ch;grid-column:2}
    .steps2 li::before{grid-row:1/3}
    .steps2 h3{grid-column:2}
    .jf{display:grid;gap:1rem;grid-template-columns:1fr;max-width:46rem}
    @media (min-width:44rem){.jf{grid-template-columns:1fr 1fr}.jf .wide,.jf .bar2,.jf .fb{grid-column:1/-1}}
    .jf .f{display:grid;gap:.3rem;min-width:0}
    .jf label{font:700 .8rem/1.3 var(--display);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-lo)}
    .jf input,.jf textarea{background:var(--card);border:1px solid var(--rule);border-radius:2px;padding:.7rem .8rem;font:inherit;color:inherit;width:100%;min-width:0}
    .jf .bar2{display:flex;gap:1rem;align-items:center;flex-wrap:wrap}
    .jf .fb{font-size:.9rem;color:var(--ink-lo)}
    .jf .fb summary{cursor:pointer;padding:.25rem 0}
    .jf .fb textarea{margin-top:.5rem;width:100%;font:.875rem/1.5 ui-monospace,Menlo,monospace;background:var(--card);border:1px solid var(--rule);padding:.75rem}
  </style>
</Base>
