---
import Base from '../../layouts/Base.astro';
import d from '@content/dept.json';
import { copy } from '../../components/copy.js';
const cp = copy(d);
const ap = (d as any).photos?.apparatus_hero as { src: string; alt: string; caption?: string } | undefined;
---
<Base title="Apparatus" description={cp.apparatus_meta}>
  <section class={ap ? "phero two" : "phero"}>
    <div class="wrap">
      <div>
        <p class="kicker">Apparatus</p>
        <h1 style="margin-top:.75rem">{cp.apparatus_h1}</h1>
        <p class="lede">{cp.apparatus_lede}</p>
      </div>
      {ap && <figure class="hphoto"><img src={ap.src} alt={ap.alt} width="1100" height="400" fetchpriority="high" style="aspect-ratio:auto" />{ap.caption && <figcaption>{ap.caption}</figcaption>}</figure>}
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      <div class="rigs" data-reveal-group>
        {d.apparatus.map((r) => (
          <div class="rig">{r.photo ? <img class="rphoto" src={r.photo.replace(".jpg","-800.jpg")} alt={r.alt || `${r.kind} ${r.id}`} loading="lazy" width="800" height="600" /> : <div class="photo" role="img" aria-label={`Reserved for a photograph of ${r.kind} ${r.id}`}><span>{r.kind} {r.id}</span></div>}<div class="in"><div class="id">{r.id}</div><div class="kind">{r.kind}{r.year ? ` · ${r.year}` : ""}</div><div class="mk">{r.make}</div><div class="sp">{r.spec}</div><div class="ro">{r.role}</div></div></div>
        ))}
      </div>
      <p class="small" style="margin-top:1.5rem;max-width:62ch">{cp.apparatus_note}</p>
    </div>
  </section>
</Base>
