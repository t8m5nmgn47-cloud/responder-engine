---
import Base from '../../layouts/Base.astro';
import d from '@content/dept.json';
import { copy } from '../../components/copy.js';
const cp = copy(d);
const mh = ((d as any).photos?.members_hero ?? d.hero_photo) as { src: string; alt: string; caption: string };
---
<Base title="Members" description={cp.members_meta}>
  <section class="phero two">
    <div class="wrap">
      <div>
        <p class="kicker">Members</p>
        <h1 style="margin-top:.75rem">{cp.members_h1}</h1>
        <p class="lede">{cp.members_lede}</p>
      </div>
      <figure class="hphoto"><img src={mh.src} alt={mh.alt} width="1100" height="400" fetchpriority="high" style="aspect-ratio:auto" /><figcaption>{mh.caption}</figcaption></figure>
    </div>
  </section>

  {d.captains.length > 0 && <section class="section band">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">Captains</p><h2>Who runs each rig</h2></div>
      <dl class="rows" style="max-width:48rem">
        {d.captains.map((c) => <div class="row"><dt>{c.unit}</dt><dd>{c.name}{c.note && <span class="small"> · {c.note}</span>}</dd></div>)}
      </dl>
      {cp.roster_note && <p class="small" style="margin-top:1rem;max-width:62ch">{cp.roster_note}</p>}
    </div>
  </section>}

  {d.honor_guard && <section class="section">
    <div class="wrap">
      <div class="head" id="honor-guard" data-reveal><p class="kicker">Honor guard</p><h2>{cp.honor_guard_title}</h2></div>
      <div class="prose"><p>{d.honor_guard}</p></div>
    </div>
  </section>}

  <section class="section tight band">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">Honorary members and awards</p><h2>Those who served before</h2></div>
      <div class="prose">
        <p>{cp.honorary}</p>
      </div>
    </div>
  </section>
</Base>
