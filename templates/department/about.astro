---
import Base from '../../layouts/Base.astro';
import d from '@content/dept.json';
import { copy } from '../../components/copy.js';
import { pick, p800 } from '../../components/photos.js';
const cp = copy(d);
const ah = pick(d, 'about_hero') as { src: string; alt: string; caption: string } | null;
const sp = pick(d, 'station') as { src: string } | null;
const oph = pick(d, 'members_hero');
import DistrictMap from '../../components/DistrictMap.astro';
const iso = (d as any).iso_rating as { class: string; year?: number; note?: string } | undefined;
const tel = (n: string) => `tel:+1${n.replace(/\D/g, '')}`;
---
<Base title="About" description={cp.about_meta}>
  <section class={ah ? "phero two" : "phero"}>
    <div class="wrap">
      <div>
        <p class="kicker">About the department</p>
        <h1 style="margin-top:.75rem">{cp.about_h1}</h1>
        <p class="lede">{cp.about_lede}</p>
      </div>
      {ah && <figure class="hphoto"><img src={ah.src} alt={ah.alt} width="1100" height="400" loading="eager" style="aspect-ratio:auto" /><figcaption>{ah.caption}</figcaption></figure>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">History</p><h2>{d.founded ? `${d.founded} to now` : cp.history_title}</h2></div>
      <div class="split"><div class="prose">{d.history.map((p) => <p>{p}</p>)}</div><aside class="aside">{ah && <figure class="aside-photo"><img src={p800(ah)} alt={ah.alt} loading="lazy" width="800" height="1000" /><figcaption>{ah.caption || ah.alt}</figcaption></figure>}{(d.founded > 0 || d.stats.members > 0) && <div class="aside-card"><p class="kicker">By the numbers</p>{d.founded > 0 && <p class="big">{new Date().getFullYear() - d.founded} <b>years</b></p>}{d.stats.members > 0 && <p>{d.stats.members} members, answering from {cp.station_label}.</p>}</div>}</aside></div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">Leadership</p><h2>{(d as any).copy?.leaders_title ?? (d.chiefs.length === 1 ? d.chiefs[0].title : 'Officers')}</h2></div>
      <div class={d.chiefs.length <= 2 ? "split" : ""}><div><div class="people" data-reveal-group>
        {d.chiefs.map((c) => <div class="person">{c.photo && <img class="pimg" src={c.photo} alt={`${c.name}`} loading="lazy" />}<div class="nm">{c.name}</div><div class="tt">{c.title}</div>{c.since && <div class="nt">{c.title} since {c.since}</div>}{c.note && <div class="nt">{c.note}</div>}{c.phone && <div class="nt"><a href={tel(c.phone)}>{c.phone}</a></div>}</div>)}
      </div>
      {d.chiefs_note && <p class="small" style="margin-top:1rem;max-width:62ch">{d.chiefs_note}</p>}
      {d.past_chiefs_note && <p class="small" style="margin-top:.5rem;max-width:62ch">{d.past_chiefs_note}</p>}
      </div>{d.chiefs.length <= 2 && oph && <aside class="aside"><figure class="aside-photo wide"><img src={p800(oph)} alt={oph.alt} loading="lazy" width="800" height="600" /><figcaption>{oph.alt}</figcaption></figure></aside>}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">Governance</p><h2>{cp.board_title}</h2></div>
      <div class="prose"><p>{d.district.board_note}</p></div>
      <dl class="rows" style="margin-top:1.5rem;max-width:48rem">
        {d.district.board.filter((b) => b.name).map((b) => <div class="row"><dt>{b.for}</dt><dd>{b.name}</dd></div>)}
        {d.district.contract.length > 0 && <div class="row"><dt>By contract</dt><dd>{d.district.contract.join(', ')}</dd></div>}
        {iso && iso.class && <div class="row"><dt>ISO rating</dt><dd>Public Protection Classification {iso.class}{iso.year && `, rated ${iso.year}`}.{iso.note && ` ${iso.note}`}</dd></div>}
      </dl>
      <p class="small" style="margin-top:1rem">{cp.board_source_note}</p>
      {cp.map && <div style="margin-top:2rem;max-width:48rem"><DistrictMap /></div>}
      {cp.map && <p class="small" style="margin-top:.5rem">{cp.map_note}</p>}
    </div>
  </section>

  <section class="section charband">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">{d.station.name}</p><h2>{cp.station_title}</h2></div>
      <div class="prose" style="max-width:62ch">
        {d.station.opened > 0 && <p>The station at {d.address.street} opened in {d.station.opened}: {d.station.size}, {d.station.cost}, {d.station.approved.toLowerCase()}.</p>}
        <p>{d.station.history}</p>
      </div>
      {sp && <figure class="hphoto" style="margin-top:2rem"><img src={sp.src} alt={cp.station_photo_alt} width="1100" height="400" loading="lazy" style="aspect-ratio:auto" />{cp.station_photo_caption && <figcaption style="color:rgba(243,239,230,.7)">{cp.station_photo_caption}</figcaption>}</figure>}
    </div>
  </section>

  {cp.mission && <section class="section tight">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">Mission</p><h2>Why we exist</h2></div>
      <div class="prose"><p>{cp.mission}</p></div>
    </div>
  </section>}
</Base>
