---
import Base from '../../layouts/Base.astro';
import d from '@content/dept.json';
import { copy } from '../../components/copy.js';
import { pick, p800 } from '../../components/photos.js';
const cp = copy(d);
import inc from '@content/incidents.json';
const rp = pick(d, 'responses', 'glow') as { src: string; alt: string } | null;
// 0.12.0: the list's aside never repeats the hero photo
const rpAlt = pick(d, 'structure', 'squad', 'community') as { src: string; alt: string } | null;
const rp2 = rpAlt && (!rp || rpAlt.src !== rp.src) ? rpAlt : null;
const feed = (d as any).dispatch_feed as { label: string; url: string } | undefined;
const fmt = (s: string) => new Date(s + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
const years = inc.year_counts.slice().sort((a, b) => a.year - b.year);
const max = Math.max(1, ...years.map((y) => y.calls));
const blankNum = (s: string) => !s || /^\s*$/.test(s) || /^\d{2}-0{3,}$/.test(s);
// 0.7.0: `responses.kinds [{title, text}]` adds a 'The calls, by kind' row above the list; `responses.kinds_note`, `responses.list_link {label, href}`, `responses.report` (true shows an incident-report section using copy.incident_reports)
const rs: any = (d as any).responses || {};
const kinds: { title: string; text: string }[] = rs.kinds || [];
---
<Base title="Responses" description={`Recent responses by the ${d.name}: what we were called to, when, where in general${inc.incidents.some((r) => r.units && r.units.length) ? ', which trucks went' : ''}${inc.incidents.some((r) => r.members > 0) ? ', and how many volunteers turned out' : ''}.${years.length ? ' Plus calls by year.' : ''}`}>
  <section class={rp ? "phero two" : "phero"} style={rp ? `--pbg:url(${rp.src})` : undefined}>
    <div class="wrap">
      <div>
        <p class="kicker">Responses</p>
        <h1 style="margin-top:.75rem">{(d as any).copy?.responses_h1 ?? 'Every call, in plain words.'}</h1>
        <p class="lede">{cp.responses_lede}</p>
      </div>
      <div>
        {rp && <figure class="hphoto side"><img src={p800(rp)} alt={rp.alt} width="800" height="1067" fetchpriority="high" />{cp.responses_caption && <figcaption>{cp.responses_caption}</figcaption>}</figure>}
        {d.stats.calls_2024 > 0 && <div class="stats" data-reveal-group style="grid-template-columns:repeat(2,1fr);margin-top:1.25rem">
          <div class="stat"><div class="v" data-count>{d.stats.calls_2024}</div><div class="k">Calls in 2024</div></div>
          <div class="stat"><div class="v" data-count>{Math.round(d.stats.calls_2024 / 365 * 7)}</div><div class="k">Calls in a typical week</div></div>
        </div>}
      </div>
    </div>
  </section>

  {kinds.length > 0 && <section class="section tight band">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">What we answer</p><h2>The calls, by kind</h2></div>
      <div class="doors three kinds" data-reveal-group>{kinds.map((k) => <div class="door"><h3>{k.title}</h3><p>{k.text}</p></div>)}</div>
      {rs.kinds_note && <p class="small" style="margin-top:1.25rem;max-width:62ch">{rs.kinds_note}</p>}
    </div>
  </section>}

  <section class="section tight">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">{cp.responses_list_kicker}</p><h2>{cp.responses_list_title}</h2></div>
      {feed && feed.url && <p class="listen" style="margin:0 0 1.5rem"><b>Listen live:</b> <a href={feed.url} rel="noopener">{feed.label}</a>. A public scanner feed run by volunteers, not an official source; what you hear there is unconfirmed until it appears below.</p>}
      <div class="split"><div><ol class="runs">
        {inc.incidents.map((r) => (
          <li class="run">
            <div class="run-n">{!blankNum(r.n) && <span class="num">{r.n}</span>}<time datetime={r.date}>{fmt(r.date)}{r.time && ` · ${r.time}`}</time></div>
            <div class="run-b">
              <h3>{r.type}</h3>
              <p class="loc">{r.location}</p>
              {r.notes && <p class="nt">{r.notes}</p>}
              {(r.units.length > 0 || r.members > 0 || (r.mutual_aid && r.mutual_aid.length > 0)) && <p class="meta">{[r.units.length > 0 ? `Units ${r.units.join(', ')}` : '', r.members > 0 ? `${r.members} members` : '', r.mutual_aid && r.mutual_aid.length ? `with ${r.mutual_aid.join(', ')}` : ''].filter(Boolean).join(' · ')}</p>}
              {(r as any).source && <p class="meta"><a class="src" href={(r as any).source} rel="noopener">Source</a></p>}
            </div>
          </li>
        ))}
      </ol>
      {cp.responses_list_note && <p class="small" style="margin-top:1.5rem;max-width:62ch">{cp.responses_list_note}</p>}
      {rs.list_link && <p style="margin-top:1.25rem"><a class="btn" href={rs.list_link.href} rel="noopener">{rs.list_link.label}</a></p>}
      </div><aside class="aside">{rp2 && <figure class="aside-photo"><img src={p800(rp2)} alt={rp2.alt} loading="lazy" width="800" height="1000" /></figure>}{rs.report && <div class="aside-card"><p class="kicker">After a call</p><h3>Need an incident report?</h3><p>{cp.incident_reports}</p></div>}</aside></div>
    </div>
  </section>



  {years.length > 0 && <section class="section band">
    <div class="wrap">
      <div class="head" data-reveal><p class="kicker">By the numbers</p><h2>Calls by year</h2></div>
      <div class="bars" role="img" aria-label={`Calls by year: ${years.map((y) => `${y.year}, ${y.calls}`).join('; ')}`}>
        {years.map((y) => <div class="bar-row"><span class="bar-y">{y.year}</span><span class="bar-t"><span class="bar-f" style={`width:${(y.calls / max * 100).toFixed(0)}%`}></span></span><span class="bar-v">{y.calls}</span></div>)}
      </div>
      {cp.year_counts_note && <p class="small" style="margin-top:1rem;max-width:62ch">{cp.year_counts_note}</p>}
    </div>
  </section>}

  <section class="section tight">
    <div class="wrap">
      <div class="split"><div><div class="head" data-reveal><p class="kicker">Why it takes a few minutes</p><h2>What happens when you call 911</h2></div>
      <div class="prose"><p>Read <a href="/safety/#911">how a volunteer response works</a>, from the dispatcher's questions to the first rig out of the station, and why the time between your call and our arrival is what it is.</p></div></div>
      <aside class="aside"><div class="aside-card light"><p class="kicker">The short version</p><ul><li>You call; the page goes out while you talk.</li><li>Members drive to the station from wherever they are.</li><li>The first rig rolls as soon as a crew is aboard.</li></ul><a class="btn red" href="/safety/#911">How it works, step by step</a></div></aside></div>
    </div>
  </section>

  <style is:global>
    .kinds .door{padding:1.4rem 1.5rem;background:var(--card);border:1px solid var(--rule);border-top:4px solid var(--red)}
    .kinds .door h3{font:700 1.6rem/1 var(--display);text-transform:uppercase;color:var(--ink-hi)}
    .kinds .door p{margin-top:.6rem;color:var(--ink)}
    .runs{display:grid;gap:0;border-top:1px solid var(--rule)}
    .run{display:grid;grid-template-columns:1fr;gap:.4rem 2rem;padding:1.2rem 0;border-bottom:1px solid var(--rule)}
    @media (min-width:44rem){.run{grid-template-columns:11rem 1fr}}
    .run-n{display:grid;gap:.2rem;align-content:start}
    .run-n .num{font:700 1.3rem/1 var(--display);color:var(--red);letter-spacing:.03em}
    .run-n time{font-size:.85rem;color:var(--ink-lo);font-variant-numeric:tabular-nums}
    .run-b h3{font-size:1.35rem}
    .run-b .loc{font-weight:600;color:var(--ink-hi)}
    .run-b .nt{margin-top:.3rem;max-width:62ch}
    .run-b .meta{margin-top:.4rem;font-size:.85rem;color:var(--ink-lo);letter-spacing:.04em;text-transform:uppercase}
    .bars{display:grid;gap:.5rem;max-width:40rem}
    .bar-row{display:grid;grid-template-columns:4rem 1fr 3.5rem;align-items:center;gap:.75rem}
    .bar-y{font:700 1rem var(--display);color:var(--ink-hi)}
    .bar-t{height:1.4rem;background:var(--card);border:1px solid var(--rule);min-width:0}
    .bar-f{display:block;height:100%;background:var(--red)}
    .bar-v{font-variant-numeric:tabular-nums;text-align:right;font-weight:600}
  </style>
</Base>
