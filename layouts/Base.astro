---
import '../styles/global.css';
import '../styles/motion.css';
import d from '@content/dept.json';
import { copy } from '../components/copy.js';
const cp = copy(d);
import status from '@content/status.json';
import siteConfig from '@siteconfig';
import review from '@review';
import Feedback from '../components/Feedback.astro';
const hasReview = Array.isArray((review as any).items) && (review as any).items.length > 0;
const analytics = siteConfig.analytics || '';
const patch = (siteConfig as any).patch || '/patch.svg';
// Feedback widget (0.5.0): `"feedback": { "site": "<slug>", "endpoint"?: "<url>" }` renders components/Feedback.astro
// once per page (guided review of review.json items + free markup). Absent, nothing is emitted.
const fbCfg = (siteConfig as any).feedback;
const feedback = fbCfg && typeof fbCfg === 'object' && fbCfg.site
  ? { site: String(fbCfg.site), endpoint: String(fbCfg.endpoint || 'https://sitesforservice.org/api/site-feedback'), siteName: String(siteConfig.name || d.name) }
  : null;
// Motion layer: `"motion": false` turns it all off; `"motion": { "counters": false }` keeps the
// reveals but leaves the stat numbers static. Default is everything on. The browser's
// prefers-reduced-motion setting always wins (checked in motion.css and in the script below).
const motionCfg = (siteConfig as any).motion;
interface Props { title: string; description: string; noindex?: boolean; plain?: boolean; }
const { title, description, noindex = false, plain = false } = Astro.props;
// `plain` (0.3.4): a print-friendly page with no motion layer (the review checklist).
const motionOn = motionCfg !== false && !plain;
const countersOn = motionOn && !(motionCfg && typeof motionCfg === 'object' && motionCfg.counters === false);
const path = Astro.url.pathname;
const full = path === '/' ? `${d.name} · ${cp.title_suffix}` : `${title} · ${d.name}`;
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/apparatus/', label: 'Apparatus' },
  { href: '/responses/', label: 'Responses' },
  { href: '/safety/', label: 'Safety' },
  ...((d as any).weather ? [{ href: '/weather/', label: cp.weather_nav }] : []),
  { href: '/community/', label: 'Community' },
  { href: '/news/', label: 'News & events' },
  ...((d as any).store ? [{ href: '/shop/', label: cp.shop_nav }] : []),
  { href: '/join/', label: 'Join', cta: true },
];
const more = [
  { href: '/members/', label: 'Members' },
  { href: '/youth/', label: 'Junior program' },
  { href: '/memorial/', label: 'Memorial' },
  { href: '/support/', label: 'Support the department' },
  { href: '/contact/', label: 'Contact' },
  { href: '/accessibility/', label: 'Accessibility' },
];
const tasks: { label: string; href: string; icon?: string }[] = (d as any).tasks || [];
const feed = (d as any).dispatch_feed as { label: string; url: string } | undefined;
const iso = (d as any).iso_rating as { class: string; year?: number; note?: string } | undefined;
const lvl = (status as any).level || 'normal';
const lvlLabel: Record<string,string> = { normal: 'Burning: normal conditions', caution: 'Burning: use caution', ban: 'Burn ban in effect' };
const current = (h: string) => (path.startsWith(h) ? 'page' : undefined);
const tel = (n: string) => `tel:+1${n.replace(/\D/g, '')}`;
const a = d.address;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'FireStation', name: d.name, url: d.url, telephone: `+1-${d.phones.station}`,
  address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.city, addressRegion: a.state, postalCode: a.zip },
  areaServed: [...d.district.members, ...d.district.contract].map((n) => ({ '@type': 'AdministrativeArea', name: n })),
  foundingDate: String(d.founded), sameAs: [d.facebook],
};
---
<!doctype html>
<html lang="en" data-counters={countersOn ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#b3261e" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    {patch.endsWith(".svg") && <link rel="icon" href={patch} type="image/svg+xml" />}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&family=EB+Garamond:wght@500&display=swap" />
    {motionOn && <script is:inline>
      (function(){
        if(!window.matchMedia||matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver' in window))return;
        var H=document.documentElement;H.classList.add('m-on');
        var counters=H.getAttribute('data-counters')==='true',DUR=450,STAG=60,MAXI=8;
        function count(el){
          var m=/^(\D*)([\d,]+)(.*)$/.exec(el.textContent.trim());if(!m||el.getAttribute('data-count')==='done')return;
          el.setAttribute('data-count','done');
          var end=parseInt(m[2].replace(/,/g,''),10),sep=m[2].indexOf(',')>-1,D=1200,t0=null,txt=el.textContent.trim();
          el.style.setProperty('--w',txt.length+'ch'); /* fixed width in ch so the band never reflows */
          var sr=document.createElement('span');sr.className='sr';sr.textContent=txt;
          var live=document.createElement('span');live.setAttribute('aria-hidden','true');live.textContent=m[1]+'0'+m[3];
          el.textContent='';el.appendChild(sr);el.appendChild(live);
          function fmt(n){n=String(n);return sep?n.replace(/\B(?=(\d{3})+(?!\d))/g,','):n;}
          function step(ts){if(t0===null)t0=ts;var p=Math.min((ts-t0)/D,1),e=1-Math.pow(1-p,3);
            live.textContent=m[1]+fmt(Math.round(end*e))+m[3];if(p<1)requestAnimationFrame(step);}
          requestAnimationFrame(step);
        }
        /* .m-done releases will-change and the reveal transition once it has really ended
           (transitionend on opacity), with a timer as a fallback. */
        function done(el,delay){var t=setTimeout(function(){el.classList.add('m-done');},DUR+delay+120);
          el.addEventListener('transitionend',function h(e){if(e.target!==el||e.propertyName!=='opacity')return;clearTimeout(t);el.classList.add('m-done');el.removeEventListener('transitionend',h);});}
        function ready(){
          var pending=[];
          function reveal(el,instant){
            var i=pending.indexOf(el);if(i<0)return;pending.splice(i,1);io.unobserve(el);
            if(el.hasAttribute('data-reveal-group')){
              var kids=el.children,n=kids.length,j;
              for(j=0;j<n;j++){var k=instant?0:Math.min(j,MAXI-1);kids[j].style.setProperty('--i',k);done(kids[j],k*STAG);}
            } else done(el,0);
            el.classList.add('is-in');
            if(counters){if(el.hasAttribute('data-count'))count(el);el.querySelectorAll('[data-count]').forEach(count);}
          }
          var io=new IntersectionObserver(function(es){es.forEach(function(x){
            if(x.isIntersecting)reveal(x.target,false);
            else if(x.boundingClientRect.bottom<0)reveal(x.target,true); /* already scrolled past (anchor load) */
          });},{threshold:0.01,rootMargin:'0px 0px -6% 0px'});
          document.querySelectorAll('[data-reveal],[data-reveal-group]').forEach(function(el){pending.push(el);io.observe(el);});
          if(counters)document.querySelectorAll('[data-count]').forEach(function(el){if(!el.closest('[data-reveal],[data-reveal-group]')){pending.push(el);io.observe(el);}});
          /* After a long jump (anchor click, drag of the scrollbar), anything left above the viewport shows at once. */
          function sweep(){if(!pending.length)return;pending.slice().forEach(function(el){if(el.getBoundingClientRect().bottom<0)reveal(el,true);});}
          if('onscrollend' in window)addEventListener('scrollend',sweep,{passive:true});else addEventListener('scroll',function(){clearTimeout(sweep.t);sweep.t=setTimeout(sweep,150);},{passive:true});
        }
        if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ready);else ready();
      })();
    </script>}
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    {analytics === 'vercel' && <Fragment set:html={`<script>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments)};</script><script defer src="/_vercel/insights/script.js"></script>`} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {d.draft_note && <p class="draft">{d.draft_note}{feedback && hasReview && <Fragment> <a class="draft-link" href="#sfs-review" data-sfs-start>Chiefs: review this site &rarr;</a></Fragment>}{!feedback && hasReview && path !== '/review/' && <Fragment> <a class="draft-link" href="/review/">Chiefs: review checklist &rarr;</a></Fragment>}</p>}
    <div class="bar">
      <div class="wrap">
        <span><b class="em">Emergency: 911</b></span>
        <span><b>Station, non-emergency:</b> <a href={tel(d.phones.station)}>{d.phones.station}</a></span>
        <span class="addr">{a.street}, {a.city}, {a.state} {a.zip}</span>
        <button class="tsz" type="button" id="tsz" aria-pressed="false" title="Larger text">A<span aria-hidden="true">A</span><span class="sr"> Larger text</span></button>
      </div>
    </div>
    <div class={`status ${lvl}`} role="status">
      <div class="wrap">
        <span class="st-dot" aria-hidden="true"></span>
        <b>{lvlLabel[lvl] || lvlLabel.normal}.</b> <span>{status.text}</span>
        {status.link && <a href={status.link} rel="noopener">{status.link_label || 'Details'}</a>}
        <span class="st-upd">Updated {new Date(status.updated + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
      </div>
    </div>
    <header class={`top${nav.length >= 9 ? " nav-wide" : ""}`} id="top">
      <div class="wrap rail">
        <a class="brand" href="/" aria-label={`${d.name} home`}>
          <img class="mk" src={patch} alt="" width="44" height="50" />
          <span><span class="bn">{cp.short}</span><span class="bs">{cp.header_tagline}</span></span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
        <nav class="nav" id="nav" aria-label="Primary">
          <ul>
            {tasks.length > 0 && <li class="iwt"><details id="iwt"><summary>I want to&hellip;</summary><ul class="iwt-menu" aria-label="Common tasks">{tasks.map((t) => <li><a href={t.href}>{t.icon && <span class="ti" aria-hidden="true">{t.icon}</span>}{t.label}</a></li>)}</ul></details></li>}
            {nav.map((n) => <li><a href={n.href} class={n.cta ? 'cta' : undefined} aria-current={current(n.href)}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="foot" id="foot">
      <div class="wrap">
        <div class="cols">
          <div class="fid">
            <img class="fpatch" src={patch} alt="" width="64" height="74" loading="lazy" />
            <h2>{d.name}</h2>
            <p class="about">{cp.footer_about ?? `${d.company}. ${cp.footer_kind} protecting ${cp.territory}, ${d.district.area_sq_mi > 0 ? `about ${d.district.area_sq_mi} square miles of ` : 'in '}${cp.county}, ${cp.state_name}.`}</p>
          </div>
          <div>
            <h2>Reach us</h2>
            <ul>
              <li>Emergency: 911</li>
              <li>Station: <a href={tel(d.phones.station)}>{d.phones.station}</a></li>
              <li>Fax: <span class="tn">{d.phones.fax}</span></li>
              <li>{a.street}, {a.city}, {a.state} {a.zip}</li>
              <li><a href={d.facebook} rel="noopener">Facebook</a></li>
              {feed && feed.url && <li class="feed"><a href={feed.url} rel="noopener">Listen live: {feed.label}</a><br /><span class="fnote">Public scanner feed, run by volunteers. Not an official source.</span></li>}
            </ul>
          </div>
          <div>
            <h2>The site</h2>
            <ul>
              <li><a href="/">Home</a></li>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
              {more.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="base">
          <span>&copy; {new Date().getFullYear()} {d.name}</span>
          <span>{d.radio && `Radio designation ${d.radio} · `}{cp.county}</span>
          {iso && iso.class && <span>ISO Class {iso.class}{iso.year && ` (${iso.year})`}</span>}
        </div>
      </div>
    </footer>
    <script is:inline>
      (function(){try{if(localStorage.getItem('ppf-big')==='1'){document.documentElement.classList.add('big');var t=document.getElementById('tsz');t&&t.setAttribute('aria-pressed','true');}}catch(e){}
      var t=document.getElementById('tsz');if(t)t.addEventListener('click',function(){var on=document.documentElement.classList.toggle('big');t.setAttribute('aria-pressed',String(on));try{localStorage.setItem('ppf-big',on?'1':'0')}catch(e){}});})();
      (function(){var b=document.querySelector('.menu-btn'),n=document.getElementById('nav');if(!b||!n)return;
      function set(o){b.setAttribute('aria-expanded',String(o));n.classList.toggle('open',o);b.textContent=o?'Close':'Menu';}
      b.addEventListener('click',function(){set(b.getAttribute('aria-expanded')!=='true');});
      document.addEventListener('keydown',function(e){if(e.key==='Escape'&&n.classList.contains('open')){set(false);b.focus();}});
      document.addEventListener('click',function(e){if(n.classList.contains('open')&&!n.contains(e.target)&&!b.contains(e.target))set(false);});})();
      (function(){var d=document.getElementById('iwt');if(!d)return;var s=d.querySelector('summary'),li=d.parentNode;
      d.addEventListener('toggle',function(){if(!d.open)return;li.classList.remove('near-edge');var m=d.querySelector('.iwt-menu');if(m&&m.getBoundingClientRect().right>innerWidth-8)li.classList.add('near-edge');});
      document.addEventListener('keydown',function(e){if(e.key==='Escape'&&d.open){d.open=false;s.focus();}});
      document.addEventListener('click',function(e){if(d.open&&!d.contains(e.target))d.open=false;});
      d.addEventListener('focusout',function(e){if(d.open&&e.relatedTarget&&!d.contains(e.relatedTarget))d.open=false;});})();
    </script>
    {feedback && !plain && <Feedback site={feedback.site} endpoint={feedback.endpoint} siteName={feedback.siteName} items={hasReview ? (review as any).items : []} />}
  </body>
</html>
